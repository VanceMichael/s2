@@ -0,0 +1,372 @@
+package server
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"os/signal"
+	"path/filepath"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/mojatter/s2"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// configEnvVars are every environment variable consulted by LoadEnv;
+// tests clear them so a developer machine or CI cannot change precedence
+// results, and restore the original values on cleanup.
+var configEnvVars = []string{
+	EnvS2ServerConfig,
+	EnvS2ServerListen,
+	EnvS2ServerConsoleListen,
+	EnvS2ServerHealthPath,
+	EnvS2ServerType,
+	EnvS2ServerRoot,
+	EnvS2ServerMaxUploadSize,
+	EnvS2ServerMaxPreviewSize,
+	EnvS2ServerMultipartMaxAge,
+	EnvS2ServerUser,
+	EnvS2ServerPassword,
+	EnvS2ServerBuckets,
+}
+
+func clearConfigEnv(t *testing.T) {
+	t.Helper()
+	for _, key := range configEnvVars {
+		v, ok := os.LookupEnv(key)
+		os.Unsetenv(key)
+		if ok {
+			t.Cleanup(func() { os.Setenv(key, v) })
+		}
+	}
+}
+
+// writeReloadConfig marshals cfg as JSON to path.
+func writeReloadConfig(t *testing.T, path string, cfg *Config) {
+	t.Helper()
+	data, err := json.MarshalIndent(cfg, "", "  ")
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(path, data, 0o644))
+}
+
+// reloadTestConfig builds a valid, self-contained config rooted in a temp
+// directory with the console disabled; mutable credential fields are
+// filled by the caller.
+func reloadTestConfig(root string) *Config {
+	cfg := DefaultConfig()
+	cfg.Root = root
+	cfg.Listen = "127.0.0.1:9911"
+	cfg.ConsoleListen = ""
+	return cfg
+}
+
+func TestConfigStoreInitialAndPublish(t *testing.T) {
+	first := &Config{User: "u1", Password: "p1"}
+	st := newConfigStore(first)
+
+	assert.Equal(t, uint64(InitialGeneration), st.generation())
+	assert.Same(t, first, st.current())
+
+	second := &Config{User: "u2", Password: "p2"}
+	gen := st.publish(second)
+	assert.Equal(t, uint64(2), gen)
+	assert.Same(t, second, st.current())
+
+	// The previous generation's pointer stays readable and untouched: a
+	// request already holding it finishes against u1/p1.
+	assert.Equal(t, "u1", first.User)
+	assert.Equal(t, "p1", first.Password)
+}
+
+func TestConfigStorePublishMonotonicUnderConcurrency(t *testing.T) {
+	st := newConfigStore(&Config{})
+	const n = 100
+
+	var wg sync.WaitGroup
+	wg.Add(n)
+	gens := make(chan uint64, n)
+	for i := 0; i < n; i++ {
+		go func() {
+			defer wg.Done()
+			gens <- st.publish(&Config{})
+		}()
+	}
+	wg.Wait()
+	close(gens)
+
+	seen := make(map[uint64]bool, n)
+	for g := range gens {
+		assert.False(t, seen[g], "duplicate generation %d", g)
+		seen[g] = true
+	}
+	assert.Equal(t, uint64(InitialGeneration+n), st.generation())
+}
+
+func TestBuildConfigPrecedence(t *testing.T) {
+	clearConfigEnv(t)
+	root := t.TempDir()
+	path := filepath.Join(root, "s2.json")
+
+	fileCfg := reloadTestConfig(root)
+	fileCfg.Listen = "127.0.0.1:7001"
+	fileCfg.User = "file-user"
+	fileCfg.Buckets = []string{"file-bucket"}
+	writeReloadConfig(t, path, fileCfg)
+
+	t.Setenv(EnvS2ServerListen, "127.0.0.1:7002")
+	t.Setenv(EnvS2ServerUser, "env-user")
+	t.Setenv(EnvS2ServerBuckets, "env-bucket")
+
+	flagListen := "127.0.0.1:7003"
+	flagBuckets := "flag-bucket"
+	f := &Flags{configFile: path, listen: &flagListen, buckets: &flagBuckets}
+
+	cfg, err := buildConfig(f)
+	require.NoError(t, err)
+
+	// Explicit flag beats env beats file.
+	assert.Equal(t, "127.0.0.1:7003", cfg.Listen)
+	assert.Equal(t, "env-user", cfg.User)
+	assert.Equal(t, []string{"flag-bucket"}, cfg.Buckets)
+	// Non-overridden file fields survive.
+	assert.Equal(t, root, cfg.Root)
+	assert.Equal(t, "/healthz", cfg.HealthPath)
+}
+
+func TestBuildConfigWithoutFile(t *testing.T) {
+	clearConfigEnv(t)
+	cfg, err := buildConfig(&Flags{})
+	require.NoError(t, err)
+	assert.Equal(t, DefaultConfig(), cfg)
+}
+
+func TestCheckImmutableFields(t *testing.T) {
+	readOnlyPolicy := &Policy{Version: "2012-10-17", Statement: []Statement{
+		{Effect: "Allow", Action: []string{ActionGetObject}, Resource: []string{"arn:aws:s3:::*"}},
+	}}
+
+	base := reloadTestConfig(t.TempDir())
+	base.User = "admin"
+	base.Password = "secret"
+	base.Buckets = []string{"initial"}
+	base.Users = []User{
+		{AccessKeyID: "ro", SecretAccessKey: "ro-secret", Policy: readOnlyPolicy},
+	}
+
+	mutable := map[string]func(*Config){
+		"legacy password rotated": func(c *Config) { c.Password = "rotated" },
+		"legacy user rotated":     func(c *Config) { c.User = "admin2" },
+		"users entry added":       func(c *Config) { c.Users = append(c.Users, User{AccessKeyID: "n2", SecretAccessKey: "s2"}) },
+		"users entry removed":     func(c *Config) { c.Users = nil },
+		"user secret rotated":     func(c *Config) { c.Users[0].SecretAccessKey = "new-secret" },
+		"user policy replaced": func(c *Config) {
+			c.Users[0].Policy = &Policy{Version: "2012-10-17", Statement: []Statement{
+				{Effect: "Allow", Action: []string{ActionListBucket}, Resource: []string{"arn:aws:s3:::*"}},
+			}}
+		},
+		"auth disabled by empty user": func(c *Config) { c.User, c.Password, c.Users = "", "", nil },
+	}
+	for name, mutate := range mutable {
+		t.Run("mutable/"+name, func(t *testing.T) {
+			cand := *base
+			mutate(&cand)
+			assert.NoError(t, checkImmutableFields(base, &cand))
+		})
+	}
+
+	immutable := map[string]func(*Config){
+		"listen":          func(c *Config) { c.Listen = "127.0.0.1:1" },
+		"console_listen":  func(c *Config) { c.ConsoleListen = "127.0.0.1:1" },
+		"health_path":     func(c *Config) { c.HealthPath = "/ready" },
+		"max_upload_size": func(c *Config) { c.MaxUploadSize = 1234 },
+		"max_preview":     func(c *Config) { c.MaxPreviewSize = 4321 },
+		"multipart_age":   func(c *Config) { c.MultipartMaxAge = 99 },
+		"buckets":         func(c *Config) { c.Buckets = []string{"different"} },
+		"storage type":    func(c *Config) { c.Type = s2.TypeMemFS },
+		"storage root":    func(c *Config) { c.Root = "/somewhere/else" },
+		"signed_url":      func(c *Config) { c.SignedURL = "http://example" },
+		"s3 backend":      func(c *Config) { c.S3 = &s2.S3Config{EndpointURL: "http://s3"} },
+		"gcs backend":     func(c *Config) { c.GCS = &s2.GCSConfig{CredentialsFile: "/k.json"} },
+		"azblob backend":  func(c *Config) { c.Azblob = &s2.AzblobConfig{AccountName: "acct"} },
+	}
+	for name, mutate := range immutable {
+		t.Run("immutable/"+name, func(t *testing.T) {
+			cand := *base
+			mutate(&cand)
+			err := checkImmutableFields(base, &cand)
+			require.Error(t, err)
+			assert.Contains(t, err.Error(), "changed at runtime")
+		})
+	}
+}
+
+func TestReloadConfigPublishesMutableChanges(t *testing.T) {
+	clearConfigEnv(t)
+	root := t.TempDir()
+	path := filepath.Join(root, "s2.json")
+
+	first := reloadTestConfig(root)
+	first.User, first.Password = "user1", "pass1"
+	writeReloadConfig(t, path, first)
+
+	f := &Flags{configFile: path}
+	cfg, err := buildConfig(f)
+	require.NoError(t, err)
+	srv, err := NewServer(context.Background(), cfg)
+	require.NoError(t, err)
+	assert.Equal(t, uint64(1), srv.ConfigGeneration())
+
+	// A request-like reader captures the generation before the reload.
+	oldGen := srv.CurrentConfig()
+
+	second := reloadTestConfig(root)
+	second.User, second.Password = "user2", "pass2"
+	second.Users = []User{
+		{AccessKeyID: "ro", SecretAccessKey: "ro-pass", Policy: &Policy{
+			Version: "2012-10-17",
+			Statement: []Statement{{
+				Effect: "Allow", Action: []string{ActionGetObject}, Resource: []string{"arn:aws:s3:::*"},
+			}},
+		}},
+	}
+	writeReloadConfig(t, path, second)
+
+	gen, err := srv.ReloadConfig(f)
+	require.NoError(t, err)
+	assert.Equal(t, uint64(2), gen)
+
+	current := srv.CurrentConfig()
+	assert.Equal(t, "user2", current.User)
+	assert.Equal(t, "pass2", current.Password)
+	require.Len(t, current.Users, 1)
+	assert.Equal(t, "ro", current.Users[0].AccessKeyID)
+
+	// The startup Config is untouched and immutable fields stayed equal.
+	assert.Equal(t, "user1", srv.Config.User)
+	assert.Equal(t, first.Listen, current.Listen)
+
+	// The captured old generation still resolves the old principal with
+	// the old secret: an in-flight request that took its snapshot before
+	// publish can never observe user2's principal or policy.
+	u := oldGen.LookupUser("user1")
+	require.NotNil(t, u)
+	assert.Equal(t, "pass1", u.SecretAccessKey)
+	assert.Nil(t, oldGen.LookupUser("user2"))
+	assert.Nil(t, oldGen.LookupUser("ro"))
+}
+
+func TestReloadConfigRejectsAndKeepsOldGeneration(t *testing.T) {
+	clearConfigEnv(t)
+	root := t.TempDir()
+	path := filepath.Join(root, "s2.json")
+
+	first := reloadTestConfig(root)
+	first.User, first.Password = "user1", "pass1"
+	writeReloadConfig(t, path, first)
+
+	f := &Flags{configFile: path}
+	cfg, err := buildConfig(f)
+	require.NoError(t, err)
+	srv, err := NewServer(context.Background(), cfg)
+	require.NoError(t, err)
+
+	// A valid rotation first, so later failures can be proven to roll back
+	// to this generation rather than the startup one.
+	rotated := reloadTestConfig(root)
+	rotated.User, rotated.Password = "good2", "good2-pass"
+	writeReloadConfig(t, path, rotated)
+	gen, err := srv.ReloadConfig(f)
+	require.NoError(t, err)
+	require.Equal(t, uint64(2), gen)
+
+	rejectAndKeepGen2 := func(t *testing.T, name string, write func(t *testing.T, path string)) {
+		t.Helper()
+		write(t, path)
+		_, err := srv.ReloadConfig(f)
+		require.Error(t, err, name)
+		assert.Equal(t, uint64(2), srv.ConfigGeneration(), name)
+		current := srv.CurrentConfig()
+		assert.Equal(t, "good2", current.User, name)
+		assert.Equal(t, "good2-pass", current.Password, name)
+	}
+
+	t.Run("malformed JSON", func(t *testing.T) {
+		rejectAndKeepGen2(t, "malformed JSON", func(t *testing.T, path string) {
+			require.NoError(t, os.WriteFile(path, []byte(`{ "user": "broken`), 0o644))
+		})
+	})
+
+	t.Run("missing file", func(t *testing.T) {
+		missing := filepath.Join(t.TempDir(), "missing.json")
+		_, err := srv.ReloadConfig(&Flags{configFile: missing})
+		require.Error(t, err)
+		assert.Equal(t, uint64(2), srv.ConfigGeneration())
+	})
+
+	t.Run("duplicate access key", func(t *testing.T) {
+		rejectAndKeepGen2(t, "duplicate access key", func(t *testing.T, path string) {
+			bad := reloadTestConfig(root)
+			bad.User, bad.Password = "dup", "p"
+			bad.Users = []User{
+				{AccessKeyID: "dup", SecretAccessKey: "p2"},
+			}
+			writeReloadConfig(t, path, bad)
+		})
+	})
+
+	t.Run("invalid policy", func(t *testing.T) {
+		rejectAndKeepGen2(t, "invalid policy", func(t *testing.T, path string) {
+			bad := reloadTestConfig(root)
+			bad.User, bad.Password = "good2", "good2-pass"
+			bad.Users = []User{{
+				AccessKeyID:     "ro",
+				SecretAccessKey: "ro-pass",
+				Policy: &Policy{Statement: []Statement{{
+					Effect: "Maybe", Action: []string{ActionGetObject}, Resource: []string{"arn:aws:s3:::*"},
+				}}},
+			}}
+			writeReloadConfig(t, path, bad)
+		})
+	})
+
+	t.Run("immutable field drift", func(t *testing.T) {
+		rejectAndKeepGen2(t, "immutable drift", func(t *testing.T, path string) {
+			bad := reloadTestConfig(root)
+			bad.Listen = "127.0.0.1:4242"
+			bad.User, bad.Password = "good2", "good2-pass"
+			writeReloadConfig(t, path, bad)
+		})
+	})
+
+	// Fixing the source and reloading recovers: the generation after the
+	// rejected attempts is exactly 3, proving none of them published.
+	fixed := reloadTestConfig(root)
+	fixed.User, fixed.Password = "good3", "good3-pass"
+	writeReloadConfig(t, path, fixed)
+	gen, err = srv.ReloadConfig(f)
+	require.NoError(t, err)
+	assert.Equal(t, uint64(3), gen)
+	assert.Equal(t, "good3", srv.CurrentConfig().User)
+}
+
+func TestNewReloadSignals(t *testing.T) {
+	t.Run("no config file means no SIGHUP handler", func(t *testing.T) {
+		assert.Nil(t, newReloadSignals(""))
+	})
+
+	t.Run("SIGHUP is delivered until stopped", func(t *testing.T) {
+		ch := newReloadSignals(t.Name())
+		t.Cleanup(func() { signal.Stop(ch) })
+
+		require.NoError(t, syscall.Kill(syscall.Getpid(), syscall.SIGHUP))
+		select {
+		case <-ch:
+		case <-time.After(500 * time.Millisecond):
+			t.Fatal("SIGHUP was not delivered to the reload channel")
+		}
+	})
+}
diff --git a/server/run_reload_test.go b/server/run_reload_test.go
new file mode 100644
index 0000000..3822b1f
--- /dev/null
+++ b/server/run_reload_test.go
@@ -0,0 +1,468 @@
+package server_test
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"os/signal"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/mojatter/s2/server"
+	"github.com/mojatter/s2/server/middleware"
+	"github.com/stretchr/testify/require"
+)
+
+// registerReloadProbesOnce installs the routes used by the reload E2E
+// suite exactly once per test binary.
+var registerReloadProbesOnce sync.Once
+
+// This suite drives a full `server.Run` binary-style lifecycle against a
+// config file and exercises credential rotation over real HTTP (SigV4
+// header, SigV4 presigned query, anonymous principal, and Console
+// BasicAuth) using process-directed SIGHUP/SIGTERM.
+
+var reloadEnvVars = []string{
+	"S2_SERVER_CONFIG", "S2_SERVER_LISTEN", "S2_SERVER_CONSOLE_LISTEN",
+	"S2_SERVER_HEALTH_PATH", "S2_SERVER_TYPE", "S2_SERVER_ROOT",
+	"S2_SERVER_MAX_UPLOAD_SIZE", "S2_SERVER_MAX_PREVIEW_SIZE",
+	"S2_SERVER_MULTIPART_MAX_AGE", "S2_SERVER_USER", "S2_SERVER_PASSWORD",
+	"S2_SERVER_BUCKETS",
+}
+
+func clearReloadEnv(t *testing.T) {
+	t.Helper()
+	for _, key := range reloadEnvVars {
+		v, ok := os.LookupEnv(key)
+		os.Unsetenv(key)
+		if ok {
+			t.Cleanup(func() { os.Setenv(key, v) })
+		}
+	}
+}
+
+func freeAddr(t *testing.T) string {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	addr := ln.Addr().String()
+	require.NoError(t, ln.Close())
+	return addr
+}
+
+func writeE2EConfig(t *testing.T, path string, cfg *server.Config) {
+	t.Helper()
+	data, err := json.MarshalIndent(cfg, "", "  ")
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(path, data, 0o644))
+}
+
+func e2EBaseConfig(root, s3Addr, consoleAddr string) *server.Config {
+	cfg := server.DefaultConfig()
+	cfg.Root = root
+	cfg.Listen = s3Addr
+	cfg.ConsoleListen = consoleAddr
+	return cfg
+}
+
+// --- minimal SigV4 signer (GET, empty body), mirroring middleware.sigV4 ---
+
+const emptyPayloadSHA256 = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
+
+func sigHMAC(key, data []byte) []byte {
+	h := hmac.New(sha256.New, key)
+	h.Write(data)
+	return h.Sum(nil)
+}
+
+func awsURIEncode(s string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
+			c == '-' || c == '_' || c == '.' || c == '~' {
+			b.WriteByte(c)
+		} else {
+			fmt.Fprintf(&b, "%%%02X", c)
+		}
+	}
+	return b.String()
+}
+
+func canonicalQuery(rawQuery string) string {
+	if rawQuery == "" {
+		return ""
+	}
+	type kv struct{ k, v string }
+	var pairs []kv
+	for _, part := range strings.Split(rawQuery, "&") {
+		if part == "" {
+			continue
+		}
+		k, v, found := strings.Cut(part, "=")
+		if !found {
+			v = ""
+		}
+		kDec, _ := url.QueryUnescape(k)
+		vDec, _ := url.QueryUnescape(v)
+		pairs = append(pairs, kv{awsURIEncode(kDec), awsURIEncode(vDec)})
+	}
+	sort.Slice(pairs, func(i, j int) bool {
+		if pairs[i].k != pairs[j].k {
+			return pairs[i].k < pairs[j].k
+		}
+		return pairs[i].v < pairs[j].v
+	})
+	parts := make([]string, len(pairs))
+	for i, p := range pairs {
+		parts[i] = p.k + "=" + p.v
+	}
+	return strings.Join(parts, "&")
+}
+
+// newSigV4Request builds a GET request authenticated with keyID/secret.
+// With presign=false the signature travels in the Authorization header;
+// with presign=true it travels in X-Amz-* query parameters.
+func newSigV4Request(rawURL, keyID, secret string, presign bool) *http.Request {
+	const region, service = "us-east-1", "s3"
+	now := time.Now().UTC()
+	date := now.Format("20060102")
+	datetime := now.Format("20060102T150405Z")
+	scope := date + "/" + region + "/" + service + "/aws4_request"
+
+	req, err := http.NewRequest(http.MethodGet, rawURL, nil)
+	if err != nil {
+		panic(err)
+	}
+	u := req.URL
+	payloadHash := emptyPayloadSHA256
+	rawQuery := ""
+	if presign {
+		q := u.Query()
+		q.Set("X-Amz-Algorithm", "AWS4-HMAC-SHA256")
+		q.Set("X-Amz-Credential", keyID+"/"+scope)
+		q.Set("X-Amz-Date", datetime)
+		q.Set("X-Amz-Expires", "300")
+		q.Set("X-Amz-SignedHeaders", "host")
+		u.RawQuery = q.Encode()
+		rawQuery = u.RawQuery
+		payloadHash = "UNSIGNED-PAYLOAD"
+	}
+
+	canonReq := strings.Join([]string{
+		http.MethodGet,
+		u.Path,
+		canonicalQuery(rawQuery),
+		"host:" + u.Host,
+		"",
+		"host",
+		payloadHash,
+	}, "\n")
+	canonHash := sha256.Sum256([]byte(canonReq))
+	stringToSign := "AWS4-HMAC-SHA256\n" + datetime + "\n" + scope + "\n" +
+		hex.EncodeToString(canonHash[:])
+	kDate := sigHMAC([]byte("AWS4"+secret), []byte(date))
+	kRegion := sigHMAC(kDate, []byte(region))
+	kService := sigHMAC(kRegion, []byte(service))
+	kSigning := sigHMAC(kService, []byte("aws4_request"))
+	signature := hex.EncodeToString(sigHMAC(kSigning, []byte(stringToSign)))
+
+	if presign {
+		q := u.Query()
+		q.Set("X-Amz-Signature", signature)
+		u.RawQuery = q.Encode()
+	} else {
+		req.Header.Set("X-Amz-Date", datetime)
+		req.Header.Set("X-Amz-Content-Sha256", emptyPayloadSHA256)
+		req.Header.Set("Authorization",
+			fmt.Sprintf("AWS4-HMAC-SHA256 Credential=%s/%s, SignedHeaders=host, Signature=%s",
+				keyID, scope, signature))
+	}
+	return req
+}
+
+// reloadHTTPClient disables keep-alives so polled probes never leave idle
+// server connections behind; otherwise graceful Shutdown would have to
+// reap them on its own deadline during the SIGTERM phase of the test.
+var reloadHTTPClient = &http.Client{
+	Transport: &http.Transport{DisableKeepAlives: true},
+}
+
+func doStatus(req *http.Request) int {
+	resp, err := reloadHTTPClient.Do(req)
+	if err != nil {
+		return -1
+	}
+	_ = resp.Body.Close()
+	return resp.StatusCode
+}
+
+func requireStatusEventually(t *testing.T, want int, newReq func() *http.Request) {
+	t.Helper()
+	require.Eventually(t, func() bool {
+		return doStatus(newReq()) == want
+	}, 5*time.Second, 20*time.Millisecond)
+}
+
+func requireStatusConsistently(t *testing.T, want int, newReq func() *http.Request) {
+	t.Helper()
+	deadline := time.Now().Add(400 * time.Millisecond)
+	for time.Now().Before(deadline) {
+		require.Equal(t, want, doStatus(newReq()))
+		time.Sleep(20 * time.Millisecond)
+	}
+}
+
+func selfSignal(t *testing.T, sig syscall.Signal) {
+	t.Helper()
+	require.NoError(t, syscall.Kill(syscall.Getpid(), sig))
+}
+
+func TestRunSIGHUPReload(t *testing.T) {
+	clearReloadEnv(t)
+
+	// Hold the process's SIGHUP/SIGINT/SIGTERM notifications open for the
+	// whole test. Go resets a signal to its default (terminating)
+	// disposition when the last registration stops, and a signal landing
+	// inside that Stop window can therefore kill the test process even
+	// though Run consumed it. This independent registration keeps the
+	// signals "captured" until after Run has fully returned; it is stopped
+	// last because cleanups run in reverse registration order. It does not
+	// change Run's own delivery (signals are fanned out to every
+	// registered channel).
+	holdSignals := make(chan os.Signal, 64)
+	signal.Notify(holdSignals, syscall.SIGHUP, syscall.SIGINT, syscall.SIGTERM)
+	t.Cleanup(func() { signal.Stop(holdSignals) })
+
+	root := t.TempDir()
+	configPath := filepath.Join(root, "s2.json")
+	s3Addr := freeAddr(t)
+	consoleAddr := freeAddr(t)
+	altAddr := freeAddr(t)
+
+	// Unique patterns; no handlers/s3api package is imported by this test
+	// binary, so the global registries start empty. Guarded by Once because
+	// the registries are process-global and the test may run more than once
+	// per binary (-count).
+	registerReloadProbesOnce.Do(func() {
+		probe := func(_ *server.Server, w http.ResponseWriter, _ *http.Request) {
+			w.WriteHeader(http.StatusOK)
+		}
+		server.RegisterS3HandleFunc("GET /{$}", middleware.SigV4(probe))
+		server.RegisterS3HandleFunc("GET /{bucket}/{key...}", middleware.SigV4(probe))
+		server.RegisterConsoleHandleFunc("GET /reload-probe", middleware.BasicAuth(probe))
+	})
+
+	readOnlyAnonymous := func() *server.Policy {
+		return &server.Policy{Version: "2012-10-17", Statement: []server.Statement{{
+			Effect:   "Allow",
+			Action:   []string{server.ActionGetObject},
+			Resource: []string{"arn:aws:s3:::*"},
+		}}}
+	}
+
+	// Generation 1: single legacy credential.
+	cfg := e2EBaseConfig(root, s3Addr, consoleAddr)
+	cfg.User, cfg.Password = "ak1", "sk1"
+	writeE2EConfig(t, configPath, cfg)
+
+	args := []string{"s2-server", "-f", configPath}
+	errCh := make(chan error, 1)
+	runDone := make(chan struct{})
+	go func() {
+		errCh <- server.Run(args)
+		close(runDone)
+	}()
+
+	// Fallback cleanup if an assertion fails before the explicit shutdown:
+	// terminate the still-running server and wait for it to fully exit.
+	t.Cleanup(func() {
+		select {
+		case <-runDone:
+			return
+		default:
+		}
+		_ = syscall.Kill(syscall.Getpid(), syscall.SIGTERM)
+		select {
+		case <-runDone:
+		case <-time.After(10 * time.Second):
+		}
+	})
+
+	require.Eventually(t, func() bool {
+		conn, err := net.Dial("tcp", s3Addr)
+		if err != nil {
+			return false
+		}
+		_ = conn.Close()
+		conn, err = net.Dial("tcp", consoleAddr)
+		if err != nil {
+			return false
+		}
+		_ = conn.Close()
+		return true
+	}, 5*time.Second, 10*time.Millisecond)
+
+	s3ObjectURL := "http://" + s3Addr + "/bucket/key.txt"
+	consoleURL := "http://" + consoleAddr + "/reload-probe"
+	consoleReq := func(user, pass string) *http.Request {
+		req, err := http.NewRequest(http.MethodGet, consoleURL, nil)
+		require.NoError(t, err)
+		req.SetBasicAuth(user, pass)
+		return req
+	}
+
+	requireRunning := func(stage string) {
+		t.Helper()
+		select {
+		case err := <-errCh:
+			t.Fatalf("server exited during %s: %v", stage, err)
+		default:
+		}
+	}
+
+	// --- generation 1 expectations ---
+	require.Equal(t, http.StatusOK, doStatus(newSigV4Request(s3ObjectURL, "ak1", "sk1", false)))
+	require.Equal(t, http.StatusOK, doStatus(newSigV4Request(s3ObjectURL, "ak1", "sk1", true)))
+	require.Equal(t, http.StatusForbidden, doStatus(newSigV4Request(s3ObjectURL, "ak1", "wrong", false)))
+	require.Equal(t, http.StatusForbidden, doStatus(newSigV4Request(s3ObjectURL, "", "", false)))
+	require.Equal(t, http.StatusOK, doStatus(consoleReq("ak1", "sk1")))
+	require.Equal(t, http.StatusUnauthorized, doStatus(consoleReq("ak2", "sk2")))
+
+	// --- rotate: ak2 legacy, a multi-user entry, and anonymous read ---
+	cfg = e2EBaseConfig(root, s3Addr, consoleAddr)
+	cfg.User, cfg.Password = "ak2", "sk2"
+	cfg.Users = []server.User{
+		{AccessKeyID: "mk", SecretAccessKey: "mk-secret"},
+		{AccessKeyID: server.AnonymousAccessKeyID, Policy: readOnlyAnonymous()},
+	}
+	writeE2EConfig(t, configPath, cfg)
+	selfSignal(t, syscall.SIGHUP)
+
+	// New requests use the new generation: new secrets work everywhere.
+	requireStatusEventually(t, http.StatusOK, func() *http.Request {
+		return newSigV4Request(s3ObjectURL, "ak2", "sk2", false)
+	})
+	require.Equal(t, http.StatusOK, doStatus(newSigV4Request(s3ObjectURL, "ak2", "sk2", true)))
+	require.Equal(t, http.StatusOK, doStatus(newSigV4Request(s3ObjectURL, "mk", "mk-secret", false)))
+	require.Equal(t, http.StatusOK, doStatus(consoleReq("ak2", "sk2")))
+	require.Equal(t, http.StatusOK, doStatus(consoleReq("mk", "mk-secret")))
+	// Old generation's secret can no longer authenticate a new request,
+	// neither as a header signature nor as a presigned URL.
+	require.Equal(t, http.StatusForbidden, doStatus(newSigV4Request(s3ObjectURL, "ak1", "sk1", false)))
+	require.Equal(t, http.StatusForbidden, doStatus(newSigV4Request(s3ObjectURL, "ak1", "sk1", true)))
+	require.Equal(t, http.StatusUnauthorized, doStatus(consoleReq("ak1", "sk1")))
+	// The anonymous principal from the new generation serves unsigned S3
+	// requests, but can never be used to log into the console.
+	require.Equal(t, http.StatusOK, doStatus(mustGet(s3ObjectURL)))
+	require.Equal(t, http.StatusUnauthorized, doStatus(consoleReq(server.AnonymousAccessKeyID, "")))
+
+	// --- invalid file: the service keeps gen 2 ---
+	require.NoError(t, os.WriteFile(configPath, []byte(`{ "user": "ak-broken`), 0o644))
+	selfSignal(t, syscall.SIGHUP)
+	time.Sleep(300 * time.Millisecond) // let the failed reload settle
+	requireStatusConsistently(t, http.StatusOK, func() *http.Request {
+		return newSigV4Request(s3ObjectURL, "ak2", "sk2", false)
+	})
+	requireStatusConsistently(t, http.StatusOK, func() *http.Request { return mustGet(s3ObjectURL) })
+	requireRunning("invalid config reload")
+
+	// --- fix the file and reload: generation 3 recovers ---
+	cfg = e2EBaseConfig(root, s3Addr, consoleAddr)
+	cfg.User, cfg.Password = "ak3", "sk3"
+	writeE2EConfig(t, configPath, cfg)
+	selfSignal(t, syscall.SIGHUP)
+	requireStatusEventually(t, http.StatusOK, func() *http.Request {
+		return newSigV4Request(s3ObjectURL, "ak3", "sk3", false)
+	})
+	require.Equal(t, http.StatusForbidden, doStatus(newSigV4Request(s3ObjectURL, "ak2", "sk2", false)))
+	// Anonymous principal disappeared with generation 2.
+	require.Equal(t, http.StatusForbidden, doStatus(mustGet(s3ObjectURL)))
+
+	// --- immutable drift (listen) is rejected; old listener keeps serving ---
+	cfg = e2EBaseConfig(root, altAddr, consoleAddr)
+	cfg.User, cfg.Password = "ak3", "sk3"
+	writeE2EConfig(t, configPath, cfg)
+	selfSignal(t, syscall.SIGHUP)
+	time.Sleep(300 * time.Millisecond)
+	requireStatusConsistently(t, http.StatusOK, func() *http.Request {
+		return newSigV4Request(s3ObjectURL, "ak3", "sk3", false)
+	})
+	conn, err := net.DialTimeout("tcp", altAddr, 200*time.Millisecond)
+	require.Error(t, err)
+	if conn != nil {
+		_ = conn.Close()
+	}
+	requireRunning("immutable field drift reload")
+
+	// Recovery after a drift rejection.
+	cfg = e2EBaseConfig(root, s3Addr, consoleAddr)
+	cfg.User, cfg.Password = "ak4", "sk4"
+	writeE2EConfig(t, configPath, cfg)
+	selfSignal(t, syscall.SIGHUP)
+	requireStatusEventually(t, http.StatusOK, func() *http.Request {
+		return newSigV4Request(s3ObjectURL, "ak4", "sk4", false)
+	})
+
+	// --- SIGHUP burst: bounded coalescing, service stays up, converges ---
+	cfg = e2EBaseConfig(root, s3Addr, consoleAddr)
+	cfg.User, cfg.Password = "ak5", "sk5"
+	writeE2EConfig(t, configPath, cfg)
+	for i := 0; i < 50; i++ {
+		selfSignal(t, syscall.SIGHUP)
+	}
+	requireStatusEventually(t, http.StatusOK, func() *http.Request {
+		return newSigV4Request(s3ObjectURL, "ak5", "sk5", false)
+	})
+	require.Equal(t, http.StatusOK, doStatus(mustGet("http://"+s3Addr+"/healthz")))
+	requireRunning("SIGHUP burst")
+
+	// --- disabling auth by removing all credentials also reloads ---
+	cfg = e2EBaseConfig(root, s3Addr, consoleAddr)
+	writeE2EConfig(t, configPath, cfg)
+	selfSignal(t, syscall.SIGHUP)
+	requireStatusEventually(t, http.StatusOK, func() *http.Request { return mustGet(s3ObjectURL) })
+	require.Equal(t, http.StatusOK, doStatus(mustGet(consoleURL)))
+	requireRunning("auth-disabled reload")
+
+	// --- SIGHUPs interleaved with SIGTERM converge into graceful shutdown ---
+	cfg = e2EBaseConfig(root, s3Addr, consoleAddr)
+	cfg.User, cfg.Password = "ak6", "sk6"
+	writeE2EConfig(t, configPath, cfg)
+	for i := 0; i < 20; i++ {
+		selfSignal(t, syscall.SIGHUP)
+	}
+	selfSignal(t, syscall.SIGTERM)
+	select {
+	case err := <-errCh:
+		require.NoError(t, err)
+	case <-time.After(15 * time.Second):
+		t.Fatal("Run did not return after SIGTERM interleaved with SIGHUPs")
+	}
+	require.Eventually(t, func() bool {
+		c, dialErr := net.DialTimeout("tcp", s3Addr, 200*time.Millisecond)
+		if c != nil {
+			_ = c.Close()
+		}
+		return dialErr != nil
+	}, 3*time.Second, 20*time.Millisecond)
+}
+
+func mustGet(rawURL string) *http.Request {
+	req, err := http.NewRequest(http.MethodGet, rawURL, nil)
+	if err != nil {
+		panic(err)
+	}
+	return req
+}
